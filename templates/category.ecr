<nav class="crumbs"><a href="/">Home</a> <span>/</span> <a href="/categories">Categories</a> <span>/</span> <%= @title %></nav>
<div class="section-head">
  <h1><%= @title %></h1>
  <span class="meta-dim"><%= @shards.size %> shards</span>
</div>
<div class="list-controls" role="navigation" aria-label="Listing controls">
  <span class="ctrl-label">Sort by:</span>
  <a class="ctrl<%= (@sort.nil? || @sort == "stars") ? " on" : "" %>" href="<%= Render.category_url(@slug, "stars", @filter5) %>">stars</a>
  <a class="ctrl<%= @sort == "date" ? " on" : "" %>" href="<%= Render.category_url(@slug, "date", @filter5) %>">date</a>
  <span class="ctrl-gap"></span>
  <a class="toggle<%= @filter5 ? " on" : "" %>" href="<%= Render.category_url(@slug, @sort, !@filter5) %>">
    <span class="toggle-track"><span class="toggle-knob"></span></span>
    last 5 years
  </a>
</div>
<ul class="gem-list">
  <% @shards.each do |s| %><%= Render.row(s) %><% end %>
</ul>
