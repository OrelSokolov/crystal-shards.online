<section class="hero">
  <div class="hero-crystal"><span class="crys" aria-hidden="true"><span class="plane p1"><i class="t top"></i><i class="t bot"></i></span><span class="plane p2"><i class="t top"></i><i class="t bot"></i></span><span class="plane p3"><i class="t top"></i><i class="t bot"></i></span></span></div>
  <h1>Find a Crystal shard</h1>
  <p class="hero-sub"><%= @total %> libraries from GitHub, organized by category.</p>
  <form class="hero-search" action="/search" method="get" role="search">
    <input type="search" name="q" placeholder="Search by name, description or topic…" aria-label="Search shards" autofocus>
    <button type="submit">Search</button>
  </form>
</section>

<section class="home-section">
  <div class="cols3">
    <div class="col3">
      <div class="section-head">
        <h2>Most starred</h2>
        <a class="more-link" href="/search?sort=stars" title="All popular shards">→</a>
      </div>
      <ul class="col-list">
        <% @top.each do |s| %>
        <li class="mini">
          <span class="mini-name"><a href="/shards/<%= HTML.escape(s.full_name) %>"><%= HTML.escape(s.name) %></a><span class="mini-path"><%= HTML.escape(s.full_name) %></span></span>
          <span class="mini-side">★ <%= s.stars %></span>
        </li>
        <% end %>
      </ul>
    </div>
    <div class="col3">
      <div class="section-head">
        <h2>Recently updated</h2>
        <a class="more-link" href="/search?sort=date" title="All recent updates">→</a>
      </div>
      <ul class="col-list">
        <% @recent.each do |s| %>
        <li class="mini">
          <span class="mini-name"><a href="/shards/<%= HTML.escape(s.full_name) %>"><%= HTML.escape(s.name) %></a><span class="mini-path"><%= HTML.escape(s.full_name) %></span></span>
          <span class="mini-side <%= s.status_css %>"><%= s.pushed_fmt %></span>
        </li>
        <% end %>
      </ul>
    </div>
    <div class="col3">
      <div class="section-head">
        <h2>Brand new</h2>
        <a class="more-link" href="/new?period=week" title="New shards by period">→</a>
      </div>
      <ul class="col-list">
        <% @newest.each do |s| %>
        <li class="mini">
          <span class="mini-name"><a href="/shards/<%= HTML.escape(s.full_name) %>"><%= HTML.escape(s.name) %></a><span class="mini-path"><%= HTML.escape(s.full_name) %></span></span>
          <span class="mini-side"><%= s.created_fmt %></span>
        </li>
        <% end %>
      </ul>
    </div>
  </div>
  <p class="meta-dim landing-note">Catalog generated <%= @updated %> · Browse <a href="/categories">all categories</a></p>
</section>

<section class="home-section">
  <div class="section-head">
    <h2>New shards by month</h2>
    <a class="more-link" href="/new?period=year">last year →</a>
  </div>
  <%= @chart %>
</section>
