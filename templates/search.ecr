<div class="search-head">
  <% if @q.empty? %>
  <h1>Popular shards</h1>
  <p class="meta-dim">Nothing typed — showing the most starred shards out of <%= @total %>. Refine with a query below.</p>
  <% else %>
  <h1>Search results</h1>
  <% end %>
  <form class="hero-search" action="/search" method="get" role="search">
    <input type="search" name="q" value="<%= HTML.escape(@q) %>" placeholder="Search shards…" aria-label="Search shards">
    <button type="submit">Search</button>
  </form>
  <% if !@q.empty? && @results.empty? %>
    <p class="meta-dim">Nothing found for “<%= HTML.escape(@q) %>”. Browse <a href="/categories">categories</a> instead?</p>
  <% elsif !@q.empty? %>
    <p class="meta-dim"><%= @results.size %> of <%= @total %> shards match “<%= HTML.escape(@q) %>”.</p>
  <% end %>
</div>
<div class="list-controls" role="navigation" aria-label="Listing controls">
  <span class="ctrl-label">Sort by:</span>
  <span class="seg">
    <a class="ctrl<%= @sort.to_s.empty? ? " on" : "" %>" href="<%= Render.search_url(@q, nil, @filter5) %>">relevance</a>
    <a class="ctrl<%= @sort == "stars" ? " on" : "" %>" href="<%= Render.search_url(@q, "stars", @filter5) %>">stars</a>
    <a class="ctrl<%= @sort == "date" ? " on" : "" %>" href="<%= Render.search_url(@q, "date", @filter5) %>">date</a>
  </span>
  <span class="ctrl-gap"></span>
  <a class="toggle<%= @filter5 ? " on" : "" %>" href="<%= Render.search_url(@q, @sort, !@filter5) %>">
    <span class="toggle-track"><span class="toggle-knob"></span></span>
    last 5 years
  </a>
</div>
<ul class="gem-list">
  <% @results.each do |s| %><%= Render.row(s) %><% end %>
</ul>
