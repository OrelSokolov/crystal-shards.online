<div class="search-head">
  <% if @q.empty? %>
  <h1>Popular shards</h1>
  <p class="meta-dim">Nothing typed — showing the most starred shards out of <%= @total %>. Refine with a query below.</p>
  <% else %>
  <h1>Search results</h1>
  <% end %>
  <form class="hero-search" action="/search" method="get" role="search">
    <input type="search" name="q" value="<%= HTML.escape(@q) %>" placeholder="Search shards…" aria-label="Search shards">
    <button type="submit">Search</button>
  </form>
  <% if !@q.empty? && @results.empty? %>
    <p class="meta-dim">Nothing found for “<%= HTML.escape(@q) %>”. Browse <a href="/categories">categories</a> instead?</p>
  <% elsif !@q.empty? %>
    <p class="meta-dim"><%= @results.size %> of <%= @total %> shards match “<%= HTML.escape(@q) %>”.</p>
  <% end %>
</div>
<div class="card-list">
  <% @results.each do |s| %><%= Render.card(s) %><% end %>
</div>
